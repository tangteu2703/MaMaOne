# ==========================================
# TIKTOK AUTO SYSTEM - Environment Config Template
# Copy file này thành .env và điền API Keys của bạn
# ==========================================

# Apify API (Cào TikTok Trend) - https://console.apify.com
APIFY_API_TOKEN=your_apify_token_here

# Google Gemini API (AI Dịch & Kịch Bản) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot (Optional Notification)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# TikTok Session Cookies (Lưu tự động sau khi login lần đầu)
TIKTOK_SESSION_FILE=./config/tiktok-session.json

# Cấu hình Pipeline
HASHTAGS=coding,programming,aitools,tech
MAX_VIDEOS_PER_RUN=3
MIN_VIEW_COUNT=50000
VIDEO_LANGUAGE=vi
VOICE_NAME=vi-VN-HoaiMyNeural

# SSL Bypass (Dành cho mạng công ty dùng proxy)
NODE_TLS_REJECT_UNAUTHORIZED=0

# ==========================================
# Cấu hình Tạo Ảnh AI Đa Luồng (Tab 3: Truyện Chữ -> Video)
# ==========================================
# Tier 1: Cloudflare Workers AI FLUX-schnell (Free 10,000 neurons/ngày/tài khoản)
# Hỗ trợ thêm nhiều tài khoản để xoay tua: CF_ACCOUNT_ID_2, CF_API_TOKEN_2...
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# Tier 2: Google Flow (Tự động hóa qua Chrome DevTools Protocol)
FLOW_ENABLED=false
FLOW_CDP_PORT=9222
FLOW_PROJECT_URL=https://flow.google.com/project/your-project-id
FLOW_MODELS=Nano Banana Pro,Nano Banana 2.1,Nano Banana 2 Lite

